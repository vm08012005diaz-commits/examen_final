<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aula_reserva_view_list" model="ir.ui.view">
        <field name="name">unicah.aula.reserva.list</field>
        <field name="model">unicah.aula.reserva</field>
        <field name="arch" type="xml">
            <list decoration-success="estado == 'confirmada'" decoration-info="estado == 'pendiente'" decoration-muted="estado == 'cancelada'">
                <field name="name"/>
                <field name="aula_id"/>
                <field name="solicitante_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="duracion_horas" sum="Horas totales"/>
                <field name="edificio" optional="show"/>
                <field name="capacidad" optional="hide"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="aula_reserva_view_form" model="ir.ui.view">
        <field name="name">unicah.aula.reserva.form</field>
        <field name="model">unicah.aula.reserva</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_solicitar" string="Solicitar aprobacion" type="object" class="btn-primary"
                            invisible="estado != 'borrador'"/>
                    <button name="action_confirmar" string="Aprobar" type="object" class="btn-primary"
                            invisible="estado != 'pendiente'"/>
                    <button name="action_marcar_utilizada" string="Registrar uso" type="object"
                            invisible="estado != 'confirmada'"/>
                    <button name="action_cancelar" string="Cancelar" type="object"
                            invisible="estado == 'cancelada'"/>
                    <button name="action_borrador" string="Volver a borrador" type="object"
                            invisible="estado != 'cancelada'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,pendiente,confirmada,utilizada,cancelada"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="aula_id"/>
                            <field name="solicitante_id"/>
                            <field name="edificio"/>
                            <field name="capacidad"/>
                            <field name="equipamiento"/>
                        </group>
                        <group>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                            <field name="duracion_horas"/>
                            <field name="recurrente"/>
                            <field name="repeticiones" invisible="not recurrente"/>
                        </group>
                    </group>
                    <group><field name="proposito" placeholder="Clase, examen, reunion..."/></group>
                    <group string="Registro de uso">
                        <field name="qr_html" widget="html"/>
                        <field name="codigo_qr"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="aula_reserva_view_calendar" model="ir.ui.view">
        <field name="name">unicah.aula.reserva.calendar</field>
        <field name="model">unicah.aula.reserva</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de aulas" date_start="fecha_inicio" date_stop="fecha_fin" color="aula_id">
                <field name="name"/>
                <field name="aula_id"/>
                <field name="estado"/>
            </calendar>
        </field>
    </record>
    <record id="aula_reserva_view_graph" model="ir.ui.view">
        <field name="name">unicah.aula.reserva.graph</field>
        <field name="model">unicah.aula.reserva</field>
        <field name="arch" type="xml">
            <graph string="Ocupacion por edificio" type="bar">
                <field name="edificio"/>
                <field name="duracion_horas" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="aula_reserva_view_search" model="ir.ui.view">
        <field name="name">unicah.aula.reserva.search</field>
        <field name="model">unicah.aula.reserva</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="aula_id"/>
                <field name="solicitante_id"/>
                <filter name="confirmadas" string="Confirmadas" domain="[('estado', '=', 'confirmada')]"/>
                <group>
                    <filter name="por_aula" string="Aula" context="{'group_by': 'aula_id'}"/>
                    <filter name="por_estado" string="Estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="aula_reserva_action" model="ir.actions.act_window">
        <field name="name">Reservas de aulas</field>
        <field name="res_model">unicah.aula.reserva</field>
        <field name="view_mode">list,form,calendar,graph</field>
        <field name="search_view_id" ref="aula_reserva_view_search"/>
    </record>
    <menuitem id="aula_reserva_root_menu" name="Reserva de aulas" sequence="25"/>
    <menuitem id="aula_reserva_menu" name="Reservas" parent="aula_reserva_root_menu"
              action="aula_reserva_action" sequence="10"/>
    <menuitem id="aula_reserva_analisis_menu" name="Ocupacion por edificio" parent="aula_reserva_root_menu"
              action="aula_reserva_action" sequence="20"/>
</odoo>
